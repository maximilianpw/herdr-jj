{
  "name": "herdr-jj",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/herdr-jj",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test --timeout 30000",
    "verify:herdr": "bun run build && uv run tests/verify-herdr.py"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
